# Database
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...

# Better Auth: generate a unique random value of at least 32 characters.
BETTER_AUTH_SECRET=
# Development/test only. Production startup fails if this is true.
SKIP_EMAIL_VERIFICATION=false

# Gmail SMTP (transactional email delivery)
GMAIL_SMTP_USER=demo.eid7@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# Optional canonical auth URL
# BETTER_AUTH_URL=https://idarty.com

# Booking management token lifetime in hours (default: 72)
# BOOKING_MANAGE_TOKEN_TTL_HOURS=72

# Sentry (error tracking)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
